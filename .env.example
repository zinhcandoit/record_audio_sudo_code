# ==============================================================
# HỆ THỐNG THU ÂM TELESALE - BIẾN MÔI TRƯỜNG (.ENV)
# ==============================================================

# 1. Cấu hình OpenAI Whisper API (bắt buộc để chạy ASR kiểm tra)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_WHISPER_MODEL=whisper-1

# 2. Cấu hình kết nối MongoDB (MongoDB Atlas hoặc Local)
# Ví dụ Atlas: mongodb+srv://username:password@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
# Ví dụ Local: mongodb://localhost:27017
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority

# 3. Tách biệt cơ sở dữ liệu (Requirement 8):
# - DB_NAME_SCRIPTS: Lưu trữ kịch bản telesale_cases_full.json và danh sách phân công
# - DB_NAME_RECORDINGS: Lưu trữ file audio MP3 (GridFS) và metadata kết quả thu âm
DB_NAME_SCRIPTS=telesale_scripts_db
DB_NAME_RECORDINGS=telesale_recordings_db

# 4. Ngưỡng kiểm tra chất lượng thu âm (Requirement 5)
# Điểm tương đồng RapidFuzz tối thiểu (mặc định 0.85 = 85%)
RAPIDFUZZ_SCORE_THRESHOLD=0.85
# Tốc độ đọc Words Per Minute tối thiểu theo chuẩn tiếng Việt (mặc định 4.0 WPM)
WPM_MIN_THRESHOLD=4.0

# 5. Cấu hình Server (Render tự động cung cấp biến PORT)
PORT=8000
HOST=0.0.0.0

